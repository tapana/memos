# Stage 1: Build the frontend SPA
FROM node:24-alpine AS frontend-builder
WORKDIR /web-build

# Enable corepack and install the required pnpm version
RUN corepack enable && corepack prepare pnpm@11.0.1 --activate

# Copy package manifests and lockfile
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy frontend source code
COPY web/ ./

# Build the frontend SPA (this will output to ../server/router/frontend/dist)
RUN pnpm release

# Stage 2: Build the backend Go binary
FROM golang:1.26.2-alpine AS backend-builder
WORKDIR /backend-build

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files and download dependencies
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy backend source code
COPY . .

# Copy the built frontend SPA from the frontend-builder stage
COPY --from=frontend-builder /server/router/frontend/dist ./server/router/frontend/dist

# Build the Go binary
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build \
      -trimpath \
      -ldflags="-s -w -extldflags '-static'" \
      -tags netgo,osusergo \
      -o memos \
      ./cmd/memos

# Stage 3: Runner
FROM alpine:3.21 AS runner

# Install runtime dependencies and create non-root user
RUN apk add --no-cache tzdata ca-certificates su-exec && \
    addgroup -g 10001 -S nonroot && \
    adduser -u 10001 -S -G nonroot -h /var/opt/memos nonroot && \
    mkdir -p /var/opt/memos /usr/local/memos && \
    chown -R nonroot:nonroot /var/opt/memos

# Copy binary and entrypoint
COPY --from=backend-builder /backend-build/memos /usr/local/memos/memos
COPY --chmod=755 scripts/entrypoint.sh /usr/local/memos/entrypoint.sh

# Run as root so entrypoint can fix volume permissions, then drop to nonroot
USER root

WORKDIR /var/opt/memos
VOLUME /var/opt/memos

ENV TZ="UTC" \
    MEMOS_PORT="5230"

EXPOSE 5230

ENTRYPOINT ["/usr/local/memos/entrypoint.sh", "/usr/local/memos/memos"]
